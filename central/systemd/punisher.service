[Unit]
Description=Punisher Zentrale (Ablaufsteuerung, RFID, LCD, MQTT)
# Needs the database and the broker; both run on the Pi (decision, doc 01).
# With an external broker, remove "mosquitto.service" here.
After=network-online.target mariadb.service mosquitto.service
Wants=network-online.target
PartOf=punisher.target
# The database takes a moment after boot; a failed start must not give up at once.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=punisher
# Access to SPI (MFRC522), I2C (LCD) and GPIO:  sudo usermod -aG spi,i2c,gpio punisher
SupplementaryGroups=spi i2c gpio
WorkingDirectory=/opt/punisher
ExecStart=/usr/bin/python3 /opt/punisher/punisher.py
# SIGTERM -> cleanup(): stop to every device, assignments released, session cleared.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=punisher.target
